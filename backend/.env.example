
# LLM配置
# 默认 agent；可切换到 langgraph。历史 helloagents 需独立兼容环境。
PLANNER_ENGINE=agent
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 可选：需求理解、攻略地点提取、推荐排序等轻任务使用的更快模型；留空则沿用 LLM_MODEL_ID
LLM_FAST_MODEL_ID=

# 单次模型调用超时（秒）与重试次数；超时会在任务中显示为失败而不是一直等待
LLM_TIMEOUT=90
LLM_MAX_RETRIES=1
# 越低越稳定，JSON 与校验失败导致的修复轮次越少
LLM_TEMPERATURE=0.3

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# Optional: on-demand Meituan travel/ticket queries, kept on the backend only.
MEITUAN_TRAVEL_TOKEN=

# 每个后端进程的交通查询频率，按实际账户额度配置；多进程需共享限流
# 路线校验耗时约等于 路段数 / QPS，确认账户配额后可调高（例如 3）
AMAP_ROUTE_QPS=1
# 地点搜索/详情的频率（与路线分开计算）；连续搜索过快会被高德返回 10021 限流
AMAP_POI_QPS=3
# 地理编码、行政区、天气查询共享的保守频率；仍需按账户实际权限配置。
AMAP_METADATA_QPS=1

# 路线结果缓存时长（秒），默认 6 小时；结果仍标注查询时间
ROUTE_CACHE_TTL_SECONDS=21600

# 可选：Langfuse 链路追踪（需 pip install langfuse），可看到每次模型/工具调用的耗时与 token
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Persistent planning queue (shared by workers using the same local SQLite file).
PLANNING_MAX_RUNNING=2
# Includes running and queued jobs, across workers sharing this SQLite file.
PLANNING_MAX_PENDING=12
PLANNING_MAX_PENDING_PER_OWNER=2
# Never-started jobs expire rather than silently waiting indefinitely.
PLANNING_QUEUE_TIMEOUT_SECONDS=180
PLANNING_LEASE_SECONDS=60
PLANNING_RUN_TIMEOUT_SECONDS=300
PLANNING_MAX_ATTEMPTS=3

# HTTP model/OCR/reference work, across workers sharing backend/var.
# Peer = ASGI client address, not a login identity. Configure trusted proxies explicitly.
HTTP_INTERACTIVE_RUNNING=2
HTTP_INTERACTIVE_PER_PEER_RUNNING=2
HTTP_INTERACTIVE_PER_PEER_MINUTE=12
HTTP_INTERACTIVE_PER_MINUTE=60
# Independent pool for place/photos/weather/address-route lookups.
HTTP_LOOKUP_RUNNING=12
HTTP_LOOKUP_PER_PEER_RUNNING=6
HTTP_LOOKUP_PER_PEER_MINUTE=120
HTTP_LOOKUP_PER_MINUTE=600
HTTP_REQUEST_LEASE_SECONDS=60
